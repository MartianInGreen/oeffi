<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/list_entry_background"
    android:baselineAligned="false"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/text_padding_vertical_verylax"
    android:paddingLeft="@dimen/text_padding_horizontal_verylax"
    android:paddingRight="@dimen/text_padding_horizontal_verylax"
    android:paddingTop="@dimen/text_padding_vertical_verylax">

    <de.schildbach.oeffi.directions.PearlView
        android:id="@+id/stations_departure_stops_entry_pearl"
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:paddingTop="@dimen/trip_details_stop_offset" />

    <LinearLayout
        android:layout_width="0px"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="@dimen/text_padding_horizontal_lax">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/stations_departure_stops_entry_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/text_padding_horizontal_cram"
                android:maxWidth="128dp"
                android:textColor="@color/fg_significant"
                android:textSize="@dimen/font_size_large" />

            <TextView
                android:id="@+id/stations_departure_stops_entry_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg_significant"
                android:textSize="@dimen/font_size_large"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stations_departure_stops_entry_delay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/text_padding_horizontal"
                android:textColor="#f00"
                android:textSize="@dimen/font_size_large" />

            <TextView
                android:id="@+id/stations_departure_stops_entry_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/text_padding_horizontal_lax"
                android:ellipsize="none"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxWidth="@dimen/position_max_width"
                android:singleLine="true"
                android:textColor="@color/fg_position"
                android:textSize="@dimen/font_size_large"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/stations_departure_stops_entry_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg_significant"
            android:textSize="@dimen/font_size_large" />

    </LinearLayout>

</LinearLayout>
